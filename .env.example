# ChambeApp Backend — variables de entorno
# Copia a .env y ajusta según el entorno.

# Flask
SECRET_KEY=tu-secret-key-cambia-esto
FLASK_APP=run.py
FLASK_ENV=development

# JWT (access 8h / refresh 30d)
JWT_SECRET_KEY=tu-jwt-secret-key-cambia-esto

# Base de datos
# PostgreSQL (producción/dev con Postgres):
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/chambeapp
# SQLite (fallback, dev/test sin Postgres):
DATABASE_URL=sqlite:///chambeapp.db

# Tests (SQLite en memoria)
TEST_DATABASE_URL=sqlite:///:memory:

# Redis (cache / cola)
REDIS_URL=redis://localhost:6379/0
CACHE_TYPE=RedisCache

# Onurix SMS (2FA) - https://docs.onurix.com
# Obtén credenciales en: https://portal.onurix.com/app/security/security
ONURIX_CLIENT=tu_client_id
ONURIX_KEY=tu_key
ONURIX_APP_NAME=ChambeApp
# Set to 1 para enviar SMS reales en desarrollo
SMS_SEND_DEV=0
